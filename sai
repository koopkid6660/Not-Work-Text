			while self._states.HoldingDownMouse do
				if tick() - self._values.StartDragTime >= 1 then
					self._states.MouseDragging = true
					self.updateCanvasPos()
				end
				task.wait()
			end
			self._states.MouseDragging = false
		end)
		
