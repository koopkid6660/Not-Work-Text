	if cursorPos > 1 then
		local subText = self._textbox.Text:sub(1, cursorPos - 1)
		currentLine = #subText:split("\n")
	end
	
	self._textbox.Text:gsub("\n", function()
		self._lines = self._lines + 1
	end)
	
