local function C_G2L_102()
local script = G2L["102"]
local TweenService = game:GetService("TweenService")

local button = script.Parent
local frame = script.Parent.Parent.HiddenFrame
local text = script.Parent.Parent.HiddenFrame.TextLabel
local isOpen = false

local function fadeFrame(targetTransparency)
	local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	local goal = {BackgroundTransparency = targetTransparency}
	local goal1 = {TextTransparency = targetTransparency}
	local tween = TweenService:Create(frame, tweenInfo, goal)
	local tween1 = TweenService:Create(text, tweenInfo, goal1)
	tween:Play()
	tween1:Play()
end

button.MouseButton1Click:Connect(function()
	if isOpen then
		fadeFrame(1) -- fades out
		button.Text = "Show Text"
	else
		fadeFrame(0) -- this fades in
		button.Text = "Hide Text" 
	end
	isOpen = not isOpen
end)
end
